;; Silmarillion graph schema.
;; Every glossary headword is an entry (:entry/*), told apart by :entry/type.
;; Chapters are what :entry/appears-in points at.

[;; ---- chapter ----
 {:db/ident       :chapter/name
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "Chapter title, e.g. \"Of the Darkening of Valinor\"."}
 {:db/ident       :chapter/position
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/value
  :db/doc         "Reading order, starting at 1 with Ainulindalë."}
 {:db/ident       :chapter/start-page
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "First page of the chapter. Used to map glossary page refs to chapters."}
 {:db/ident       :chapter/last-page
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "Last page of the chapter (next chapter's start page minus one)."}
 {:db/ident       :chapter/during
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many ;;many bc some chapters take place over multiple ages
  :db/doc         "Age entries this chapter takes place in."}

 ;; ---- entry (every glossary headword: characters, places, things, ...) ----
 {:db/ident       :entry/name
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "Glossary headword, or a fuller name when the headword is numbered."}
 {:db/ident       :entry/type
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc         "One of the :entry.type/* idents below."}
 {:db/ident       :entry/glossary-label
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "The glossary's numbered label, e.g. \"Míriel (2)\". Only on numbered headwords."}
 {:db/ident       :entry/description
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "Glossary text, copied verbatim."}
 {:db/ident       :entry/page
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/many
  :db/doc         "Glossary page refs, ranges expanded. appears-in is derived from these."}
 {:db/ident       :entry/appears-in
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc         "Chapters the glossary cites for this entry."}
 {:db/ident       :entry/mentions
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc         "Entries this entry's description mentions. Added by hand."}

 ;; ---- entry types ----
 {:db/ident :entry.type/character :db/doc "Individual beings."}
 {:db/ident :entry.type/place     :db/doc "Lands, rivers, mountains, cities, realms."}
 {:db/ident :entry.type/age       :db/doc "Days Before Days, First Age, Second Age, Third Age."}
 {:db/ident :entry.type/event     :db/doc "Battles, named happenings."}
 {:db/ident :entry.type/thing     :db/doc "Objects, weapons, jewels, ships, stars."}
 {:db/ident :entry.type/animal    :db/doc "Horses, hounds, eagles."}
 {:db/ident :entry.type/race      :db/doc "Peoples and kindreds."}
 {:db/ident :entry.type/house     :db/doc "Houses and lineages."}
 {:db/ident :entry.type/language  :db/doc "Spoken languages."}
 {:db/ident :entry.type/account   :db/doc "Written works, tales, songs, laments."}

 ;; ---- type-specific attributes ----
 ;; Period (Years of the Trees, Years of the Sun) is intentionally left out of the data model.
 {:db/ident       :event/during
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc         "Ages (age entries) this event takes place in."}
 {:db/ident       :house/founder
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc         "The character the house descends from, e.g. Bëor for the House of Bëor."}

 ;; ---- alias (another name for a main entry: Anar for the Sun) ----
 ;; One entity per (alias name, main entry): "The Dark Lord" has one for Melkor and one for Sauron.
 {:db/ident       :alias/key
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "\"<alias name> → <main entry name>\", e.g. \"Anar → Sun\". Identity, since names alone repeat."}
 {:db/ident       :alias/name
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "The alias as the glossary prints it."}
 {:db/ident       :alias/of
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc         "The main entry this is another name for."}
 {:db/ident       :alias/description
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "The alias's own glossary text. Also appended to the main entry's description."}
 {:db/ident       :alias/page
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/many
  :db/doc         "The alias's own page refs. Also merged into the main entry's pages."}
 {:db/ident       :alias/appears-in
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc         "Chapters where the glossary cites this name."}]
