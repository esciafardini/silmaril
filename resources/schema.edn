;; Silmarillion graph schema — glossary import, pass 1.
;; Every glossary type has the same three attributes: name, description, appears-in.
;; Chapters are what appears-in points at.

[;; ---- chapter ----
 {:db/ident       :chapter/name
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "Chapter title, e.g. \"Of the Darkening of Valinor\"."}
 {:db/ident       :chapter/position
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "Reading order, starting at 1 with Ainulindalë."}
 {:db/ident       :chapter/start-page
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "First page of the chapter. Used to map glossary page refs to chapters."}
 {:db/ident       :chapter/during
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many ;;many bc some chapters take place over multiple ages
  :db/doc         "A chapter will occur during an Age."}

 ;; ---- character ----
 {:db/ident       :character/name
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "Glossary headword, or a fuller name when the headword is numbered."}
 {:db/ident       :character/glossary-label
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "The glossary's numbered label, e.g. \"Míriel (2)\". Only on numbered headwords."}
 {:db/ident       :character/description
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "Glossary text, copied verbatim."}
 {:db/ident       :character/appears-in
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc         "Chapters the glossary cites for this entry."}
 {:db/ident       :character/page
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/many
  :db/doc         "Glossary page refs, ranges expanded. appears-in is derived from these."}

