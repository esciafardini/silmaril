 ;; ---- alias (another name for a main entry: Anar for the Sun) ----
 ;; One entity per (alias name, main entry): "The Dark Lord" has one for Melkor and one for Sauron.
 {:db/ident       :alias/key
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "\"<alias name> → <main entry name>\", e.g. \"Anar → Sun\". Identity, since names alone repeat."}
 {:db/ident       :alias/name
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "The alias as the glossary prints it."}
 {:db/ident       :alias/of
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc         "The main entry this is another name for."}
 {:db/ident       :alias/description
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "The alias's own glossary text. Also appended to the main entry's description."}
 {:db/ident       :alias/page
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/many
  :db/doc         "The alias's own page refs. Also merged into the main entry's pages."}
 {:db/ident       :alias/appears-in
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc         "Chapters where the glossary cites this name."}

 ;; ---- mentions (any entry type) ----
 {:db/ident       :entry/mentions
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc         "Entities this entry's description mentions. Added by hand."}]
