{:deps {com.datomic/local {:mvn/version "1.0.301"}
        ring/ring-core {:mvn/version "1.15.3"}
        ring/ring-jetty-adapter {:mvn/version "1.15.3"}}
 :aliases
 {;; One JVM: nREPL + shadow-cljs + the Ring server. See README.
  :dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.50.2"}
                     thheller/shadow-cljs {:mvn/version "3.5.14"}
                     reagent/reagent {:mvn/version "1.3.0"}}
        :main-opts ["-m" "nrepl.cmdline"
                    "--middleware" "[cider.nrepl/cider-middleware,shadow.cljs.devtools.server.nrepl/middleware]"]}}}
